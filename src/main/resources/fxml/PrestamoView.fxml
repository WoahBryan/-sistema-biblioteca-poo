<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="500.0" prefWidth="780.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utj.dsm.poo.biblioteca.controlador.PrestamoViewController">
   <children>
      <Label layoutX="30.0" layoutY="20.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Gestión de Préstamos" />

      <Label layoutX="30.0" layoutY="75.0" text="ID:" />
      <TextField fx:id="txtId" disable="true" layoutX="150.0" layoutY="70.0" prefWidth="180.0" />

      <Label layoutX="30.0" layoutY="115.0" text="Usuario:" />
      <TextField fx:id="txtUsuario" layoutX="150.0" layoutY="110.0" prefWidth="180.0" />
      <Label fx:id="lblErrorUsuario" layoutX="150.0" layoutY="135.0" style="-fx-font-size: 10px;" textFill="RED" />

      <Label layoutX="30.0" layoutY="155.0" text="Libro:" />
      <TextField fx:id="txtLibro" layoutX="150.0" layoutY="150.0" prefWidth="180.0" />
      <Label fx:id="lblErrorLibro" layoutX="150.0" layoutY="175.0" style="-fx-font-size: 10px;" textFill="RED" />

      <Label layoutX="30.0" layoutY="195.0" text="Fecha Préstamo:" />
      <TextField fx:id="txtFechaPrestamo" layoutX="150.0" layoutY="190.0" promptText="AAAA-MM-DD" prefWidth="180.0" />
      <Label fx:id="lblErrorFechaPrestamo" layoutX="150.0" layoutY="215.0" style="-fx-font-size: 10px;" textFill="RED" />

      <Label layoutX="30.0" layoutY="235.0" text="Fecha Devolución:" />
      <TextField fx:id="txtFechaDevolucion" layoutX="150.0" layoutY="230.0" promptText="AAAA-MM-DD" prefWidth="180.0" />
      <Label fx:id="lblErrorFechaDevolucion" layoutX="150.0" layoutY="255.0" style="-fx-font-size: 10px;" textFill="RED" />

      <Button fx:id="btnNuevo" layoutX="30.0" layoutY="350.0" text="Nuevo" />
      <Button fx:id="btnValidar" layoutX="90.0" layoutY="350.0" onAction="#accionValidar" text="Validar" />
      <Button fx:id="btnGuardar" disable="true" layoutX="155.0" layoutY="350.0" text="Guardar" />
      <Button fx:id="btnEditar" disable="true" layoutX="225.0" layoutY="350.0" text="Editar" />
      <Button fx:id="btnEliminar" disable="true" layoutX="285.0" layoutY="350.0" text="Eliminar" />
      <Button fx:id="btnLimpiar" layoutX="355.0" layoutY="350.0" onAction="#accionLimpiar" text="Limpiar" />

      <TableView fx:id="tablaPrestamos" layoutX="430.0" layoutY="20.0" prefHeight="450.0" prefWidth="330.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="30.0" text="ID" />
          <TableColumn fx:id="colUsuario" prefWidth="75.0" text="Usuario" />
          <TableColumn fx:id="colLibro" prefWidth="75.0" text="Libro" />
          <TableColumn fx:id="colFechaPrestamo" prefWidth="75.0" text="Préstamo" />
          <TableColumn fx:id="colFechaDevolucion" prefWidth="75.0" text="Devolución" />
        </columns>
      </TableView>
   </children>
</AnchorPane>