<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="500.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utj.dsm.poo.biblioteca.controlador.BibliotecarioViewController">
   <children>
      <Label layoutX="30.0" layoutY="20.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Gestión de Bibliotecario" />

      <Label layoutX="30.0" layoutY="75.0" text="ID:" />
      <TextField fx:id="txtId" disable="true" layoutX="140.0" layoutY="70.0" prefWidth="180.0" />

      <Label layoutX="30.0" layoutY="115.0" text="Nombre:" />
      <TextField fx:id="txtNombre" layoutX="140.0" layoutY="110.0" onKeyTyped="#restringirLetras" prefWidth="180.0" />
      <Label fx:id="lblErrorNombre" layoutX="140.0" layoutY="135.0" style="-fx-font-size: 10px;" textFill="RED" />

      <Label layoutX="30.0" layoutY="155.0" text="Primer Apellido:" />
      <TextField fx:id="txtPrimerApellido" layoutX="140.0" layoutY="150.0" onKeyTyped="#restringirLetras" prefWidth="180.0" />
      <Label fx:id="lblErrorApellido" layoutX="140.0" layoutY="175.0" style="-fx-font-size: 10px;" textFill="RED" />

      <Label layoutX="30.0" layoutY="195.0" text="Turno:" />
      <TextField fx:id="txtTurno" layoutX="140.0" layoutY="190.0" prefWidth="180.0" />
      <Label fx:id="lblErrorTurno" layoutX="140.0" layoutY="215.0" style="-fx-font-size: 10px;" textFill="RED" />

      <Label layoutX="30.0" layoutY="235.0" text="Área:" />
      <TextField fx:id="txtArea" layoutX="140.0" layoutY="230.0" prefWidth="180.0" />
      <Label fx:id="lblErrorArea" layoutX="140.0" layoutY="255.0" style="-fx-font-size: 10px;" textFill="RED" />

      <VBox alignment="CENTER" layoutX="30.0" layoutY="280.0" spacing="5.0">
         <children>
            <ImageView fx:id="imgFoto" fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true" style="-fx-border-color: gray;" />
            <Button style="-fx-font-size: 10px;" text="Seleccionar imagen" />
         </children>
      </VBox>

      <Button fx:id="btnNuevo" layoutX="30.0" layoutY="370.0" text="Nuevo" />
      <Button fx:id="btnValidar" layoutX="90.0" layoutY="370.0" onAction="#accionValidar" text="Validar" />
      <Button fx:id="btnGuardar" disable="true" layoutX="155.0" layoutY="370.0" text="Guardar" />
      <Button fx:id="btnEditar" disable="true" layoutX="225.0" layoutY="370.0" text="Editar" />
      <Button fx:id="btnEliminar" disable="true" layoutX="285.0" layoutY="370.0" text="Eliminar" />
      <Button fx:id="btnLimpiar" layoutX="355.0" layoutY="370.0" onAction="#accionLimpiar" text="Limpiar" />

      <TableView fx:id="tablaBibliotecarios" layoutX="430.0" layoutY="20.0" prefHeight="450.0" prefWidth="300.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="30.0" text="ID" />
          <TableColumn fx:id="colNombre" prefWidth="70.0" text="Nombre" />
          <TableColumn fx:id="colApellido" prefWidth="70.0" text="Apellido" />
          <TableColumn fx:id="colTurno" prefWidth="65.0" text="Turno" />
          <TableColumn fx:id="colArea" prefWidth="65.0" text="Área" />
        </columns>
      </TableView>
   </children>
</AnchorPane>