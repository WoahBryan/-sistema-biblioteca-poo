<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="550.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utj.dsm.poo.biblioteca.controlador.LibroViewController">
   <children>
      <Label layoutX="30.0" layoutY="20.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Gestión de Libros" />

      <Label layoutX="30.0" layoutY="70.0" text="ID:" />
      <TextField fx:id="txtId" disable="true" layoutX="120.0" layoutY="65.0" prefWidth="200.0" />

      <Label layoutX="30.0" layoutY="110.0" text="Título:" />
      <TextField fx:id="txtTitulo" layoutX="120.0" layoutY="105.0" prefWidth="200.0" />
      <Label fx:id="lblErrorTitulo" layoutX="120.0" layoutY="130.0" style="-fx-font-size: 10px;" textFill="RED" />

      <Label layoutX="30.0" layoutY="150.0" text="Autor:" />
      <TextField fx:id="txtAutor" layoutX="120.0" layoutY="145.0" onKeyTyped="#restringirLetras" prefWidth="200.0" />
      <Label fx:id="lblErrorAutor" layoutX="120.0" layoutY="170.0" style="-fx-font-size: 10px;" textFill="RED" />

      <Label layoutX="30.0" layoutY="190.0" text="Editorial:" />
      <TextField fx:id="txtEditorial" layoutX="120.0" layoutY="185.0" prefWidth="200.0" />
      <Label fx:id="lblErrorEditorial" layoutX="120.0" layoutY="210.0" style="-fx-font-size: 10px;" textFill="RED" />

      <Label layoutX="30.0" layoutY="230.0" text="ISBN:" />
      <TextField fx:id="txtISBN" layoutX="120.0" layoutY="225.0" onKeyTyped="#restringirNumeros" prefWidth="200.0" />
      <Label fx:id="lblErrorISBN" layoutX="120.0" layoutY="250.0" style="-fx-font-size: 10px;" textFill="RED" />

      <Label layoutX="30.0" layoutY="270.0" text="Páginas:" />
      <TextField fx:id="txtPaginas" layoutX="120.0" layoutY="265.0" onKeyTyped="#restringirNumeros" prefWidth="200.0" />
      <Label fx:id="lblErrorPaginas" layoutX="120.0" layoutY="290.0" style="-fx-font-size: 10px;" textFill="RED" />

      <!-- Sección de las 3 Imágenes requeridas por el Profesor -->
      <Label layoutX="30.0" layoutY="315.0" style="-fx-font-weight: bold;" text="Imágenes del Libro (Portada, Contraportada, Lomo):" />
      <HBox layoutX="30.0" layoutY="340.0" spacing="15.0">
         <children>
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <ImageView fx:id="imgPortada" fitHeight="80.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true" style="-fx-border-color: gray;" />
                  <Button text="Portada" style="-fx-font-size: 10px;" />
               </children>
            </VBox>
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <ImageView fx:id="imgContraportada" fitHeight="80.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true" style="-fx-border-color: gray;" />
                  <Button text="Contraportada" style="-fx-font-size: 10px;" />
               </children>
            </VBox>
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <ImageView fx:id="imgLomo" fitHeight="80.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true" style="-fx-border-color: gray;" />
                  <Button text="Lomo" style="-fx-font-size: 10px;" />
               </children>
            </VBox>
         </children>
      </HBox>

      <Button fx:id="btnNuevo" layoutX="30.0" layoutY="480.0" text="Nuevo" />
      <Button fx:id="btnValidar" layoutX="90.0" layoutY="480.0" onAction="#accionValidar" text="Validar" />
      <Button fx:id="btnGuardar" disable="true" layoutX="155.0" layoutY="480.0" text="Guardar" />
      <Button fx:id="btnEditar" disable="true" layoutX="225.0" layoutY="480.0" text="Editar" />
      <Button fx:id="btnEliminar" disable="true" layoutX="285.0" layoutY="480.0" text="Eliminar" />
      <Button fx:id="btnLimpiar" layoutX="355.0" layoutY="480.0" onAction="#accionLimpiar" text="Limpiar" />

      <TableView fx:id="tablaLibros" layoutX="430.0" layoutY="20.0" prefHeight="500.0" prefWidth="350.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="30.0" text="ID" />
          <TableColumn fx:id="colTitulo" prefWidth="80.0" text="Título" />
          <TableColumn fx:id="colAutor" prefWidth="70.0" text="Autor" />
          <TableColumn fx:id="colEditorial" prefWidth="70.0" text="Editorial" />
          <TableColumn fx:id="colIsbn" prefWidth="50.0" text="ISBN" />
          <TableColumn fx:id="colPaginas" prefWidth="50.0" text="Páginas" />
        </columns>
      </TableView>
   </children>
</AnchorPane>