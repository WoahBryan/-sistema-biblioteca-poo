<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" prefHeight="350.0" prefWidth="400.0" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="edu.utj.dsm.poo.biblioteca.controlador.LoginController">
    <padding>
        <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Iniciar Sesión" />
        
        <VBox alignment="CENTER_LEFT" spacing="5.0">
            <children>
                <Label text="Correo o Usuario:" />
                <TextField fx:id="txtUsuario" promptText="admin@biblioteca.com" />
            </children>
        </VBox>
        
        <VBox alignment="CENTER_LEFT" spacing="5.0">
            <children>
                <Label text="Contraseña:" />
                <PasswordField fx:id="txtContrasena" promptText="••••••••" />
            </children>
        </VBox>
        
        <Label fx:id="lblMensaje" textFill="RED" style="-fx-font-size: 11px;" />
        
        <Button fx:id="btnIngresar" onAction="#accionIngresar" prefWidth="200.0" text="Ingresar" />
        <Button onAction="#accionSalir" prefWidth="200.0" text="Salir del Sistema" />
    </children>
</VBox>