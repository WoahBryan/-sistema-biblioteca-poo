<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="550.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utj.dsm.poo.biblioteca.controlador.RevistaViewController">
   <children>
      <Label layoutX="30.0" layoutY="20.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Gestión de Revistas" />

      <Label layoutX="30.0" layoutY="70.0" text="ID:" />
      <TextField fx:id="txtId" disable="true" layoutX="130.0" layoutY="65.0" prefWidth="190.0" />

      <Label layoutX="30.0" layoutY="110.0" text="Título:" />
      <TextField fx:id="txtTitulo" layoutX="130.0" layoutY="105.0" prefWidth="190.0" />
      <Label fx:id="lblErrorTitulo" layoutX="130.0" layoutY="130.0" style="-fx-font-size: 10px;" textFill="RED" />

      <Label layoutX="30.0" layoutY="150.0" text="Editorial:" />
      <TextField fx:id="txtEditorial" layoutX="130.0" layoutY="145.0" prefWidth="190.0" />
      <Label fx:id="lblErrorEditorial" layoutX="130.0" layoutY="170.0" style="-fx-font-size: 10px;" textFill="RED" />

      <Label layoutX="30.0" layoutY="190.0" text="ISSN:" />
      <TextField fx:id="txtIssn" layoutX="130.0" layoutY="185.0" prefWidth="190.0" />
      <Label fx:id="lblErrorIssn" layoutX="130.0" layoutY="210.0" style="-fx-font-size: 10px;" textFill="RED" />

      <Label layoutX="30.0" layoutY="230.0" text="Número:" />
      <TextField fx:id="txtNumero" layoutX="130.0" layoutY="225.0" onKeyTyped="#restringirNumeros" prefWidth="190.0" />
      <Label fx:id="lblErrorNumero" layoutX="130.0" layoutY="250.0" style="-fx-font-size: 10px;" textFill="RED" />

      <Label layoutX="30.0" layoutY="270.0" text="Periodicidad:" />
      <TextField fx:id="txtPeriodicidad" layoutX="130.0" layoutY="265.0" prefWidth="190.0" />
      <Label fx:id="lblErrorPeriodicidad" layoutX="130.0" layoutY="290.0" style="-fx-font-size: 10px;" textFill="RED" />

      <Button fx:id="btnNuevo" layoutX="30.0" layoutY="450.0" text="Nuevo" />
      <Button fx:id="btnValidar" layoutX="90.0" layoutY="450.0" onAction="#accionValidar" text="Validar" />
      <Button fx:id="btnGuardar" disable="true" layoutX="155.0" layoutY="450.0" text="Guardar" />
      <Button fx:id="btnEditar" disable="true" layoutX="225.0" layoutY="450.0" text="Editar" />
      <Button fx:id="btnEliminar" disable="true" layoutX="285.0" layoutY="450.0" text="Eliminar" />
      <Button fx:id="btnLimpiar" layoutX="355.0" layoutY="450.0" onAction="#accionLimpiar" text="Limpiar" />

      <TableView fx:id="tablaRevistas" layoutX="430.0" layoutY="20.0" prefHeight="480.0" prefWidth="350.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="30.0" text="ID" />
          <TableColumn fx:id="colTitulo" prefWidth="80.0" text="Título" />
          <TableColumn fx:id="colEditorial" prefWidth="70.0" text="Editorial" />
          <TableColumn fx:id="colIssn" prefWidth="50.0" text="ISSN" />
          <TableColumn fx:id="colNumero" prefWidth="40.0" text="Nº" />
          <TableColumn fx:id="colPeriodicidad" prefWidth="80.0" text="Periodicidad" />
        </columns>
      </TableView>
   </children>
</AnchorPane>