<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="500.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utj.dsm.poo.biblioteca.controlador.EditorialViewController">
   <children>
      <Label layoutX="30.0" layoutY="20.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Gestión de Editoriales" />

      <Label layoutX="30.0" layoutY="80.0" text="ID:" />
      <TextField fx:id="txtId" disable="true" layoutX="120.0" layoutY="75.0" prefWidth="200.0" />

      <Label layoutX="30.0" layoutY="130.0" text="Nombre:" />
      <TextField fx:id="txtNombre" layoutX="120.0" layoutY="125.0" prefWidth="200.0" />
      <Label fx:id="lblErrorNombre" layoutX="120.0" layoutY="150.0" style="-fx-font-size: 10px;" textFill="RED" />

      <Label layoutX="30.0" layoutY="180.0" text="País:" />
      <TextField fx:id="txtPais" layoutX="120.0" layoutY="175.0" onKeyTyped="#restringirLetras" prefWidth="200.0" />
      <Label fx:id="lblErrorPais" layoutX="120.0" layoutY="200.0" style="-fx-font-size: 10px;" textFill="RED" />

      <Button fx:id="btnNuevo" layoutX="30.0" layoutY="350.0" text="Nuevo" />
      <Button fx:id="btnValidar" layoutX="90.0" layoutY="350.0" onAction="#accionValidar" text="Validar" />
      <Button fx:id="btnGuardar" disable="true" layoutX="155.0" layoutY="350.0" text="Guardar" />
      <Button fx:id="btnEditar" disable="true" layoutX="225.0" layoutY="350.0" text="Editar" />
      <Button fx:id="btnEliminar" disable="true" layoutX="285.0" layoutY="350.0" text="Eliminar" />
      <Button fx:id="btnLimpiar" layoutX="355.0" layoutY="350.0" onAction="#accionLimpiar" text="Limpiar" />

      <TableView fx:id="tablaEditoriales" layoutX="430.0" layoutY="20.0" prefHeight="450.0" prefWidth="300.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="40.0" text="ID" />
          <TableColumn fx:id="colNombre" prefWidth="130.0" text="Nombre" />
          <TableColumn fx:id="colPais" prefWidth="120.0" text="País" />
        </columns>
      </TableView>
   </children>
</AnchorPane>